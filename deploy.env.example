# Docker Compose
COMPOSE_PROJECT_NAME=hermes
HERMES_IMAGE=ghcr.io/pihpohpah/hermes
# Для scripts/deploy.sh по умолчанию используется короткий Git SHA.
# HERMES_TAG=latest
PULL_POLICY=always
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
TZ=Asia/Vladivostok
APP_ENV=prod

# База данных: креды сервиса db и DATABASE_URL сервиса api собираются из
# этих значений. Пароль должен быть без символов, значимых в URL
# (@, :, /, # и т.п.), иначе DATABASE_URL не разберётся.
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hermes

# scripts/deploy.sh
BUILD_PLATFORM=linux/amd64
DEPLOY_HOST=server.example.com
DEPLOY_USER=deploy
DEPLOY_SSH_PORT=22
DEPLOY_PATH=/opt/hermes
DEPLOY_HEALTH_TIMEOUT=60
