APP_ENV=dev
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes?sslmode=disable
DB_PING_TIMEOUT=5s
POSTGRES_DB=hermes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_CONTAINER=postgres-1
# real - реальные данные Open-Meteo, mock - явно выбранные демо-данные.
# Сбой real не подменяется mock-данными.
WEATHER_MODE=real
OPENMETEO_BASE=https://api.open-meteo.com/v1
OPENMETEO_MARINE_BASE=https://marine-api.open-meteo.com/v1
OPENMETEO_AIR_QUALITY_BASE=https://air-quality-api.open-meteo.com/v1
OPENMETEO_TIMEOUT=8s
OPENMETEO_ATTEMPTS=3
OPENMETEO_RETRY_BACKOFF=300ms
OPENMETEO_API_KEY=
PMTILES_PATH=./web/static/pmtiles/primorsky-krai-z15.pmtiles
RELIEF_PATH=./web/static/pmtiles/primorsky-relief.pmtiles
MAP_DIR=./web/map
WEB_DIR=./web/static
APP_READ_HEADER_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=15s
# Срок жизни серверной сессии (cookie + запись в user_sessions).
SESSION_TTL=720h
# Список через запятую origin, которым разрешены credentialed CORS-запросы.
# Пусто = только same-origin.
CORS_ALLOWED_ORIGINS=
# Вход через Telegram Login Widget. Пустой токен = вход выключен.
# Берутся у @BotFather; username — без «@» (например, hermes_vl_bot).
# Пустой TELEGRAM_BOT_USERNAME — username выяснится через getMe при старте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Прокси для вызовов Bot API (getMe и далее): список через запятую, каждая
# неудачная попытка идёт через следующий. Только http(s):
# http://user:pass@host:port. Пусто = напрямую.
TELEGRAM_PROXY_LIST=
# Сколько попыток (смен прокси) делать к Bot API, по умолчанию 6.
TELEGRAM_MAX_ATTEMPTS=
LOG_LEVEL=DEBUG
LOG_ADD_SOURCE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=0.1.0
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0
