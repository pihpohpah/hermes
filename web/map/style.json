    {
      "id": "boundary-region",
      "type": "line",
      "source": "region",
      "source-layer": "boundary",
      "filter": [
        "<=",
        "admin_level",
        4
      ],
      "paint": {
        "line-color": "var(--map-boundary)",
        "line-width": 1.2,
        "line-dasharray": [
          3,
          2
        ]
      },
      "metadata": {
        "hermes:mode": "both"
      }
    },
    {
      "id": "road-track",
      "type": "line",
      "source": "region",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "track"
      ],
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "var(--map-track)",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.5,
          14,
          1.6
        ],
        "line-dasharray": [
          2,
          1.4
        ]
      },
      "metadata": {
        "hermes:mode": "both"
      }
    },
    {
      "id": "road-footpath",
      "type": "line",
      "source": "region",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "class",
          "path"
        ],
        [
          "in",
          "subclass",
          "footway",
          "path",
          "steps",
          "pedestrian",
          "bridleway",
          "cycleway"
        ]
      ],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "case",
          [
            "==",
            [
              "get",
              "hiking_route"
            ],
            1
          ],
          "var(--map-hiking-route)",
          "var(--map-path)"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          14,
          1.8
        ],
        "line-dasharray": [
          2,
          1.6
        ]
      },
      "metadata": {
        "hermes:mode": "both"
      }
    },
    {
      "id": "road-service-casing",
