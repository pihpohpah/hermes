    {
      "id": "road-label",
      "type": "symbol",
      "source": "region",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "var(--map-label)",
        "text-halo-color": "var(--map-label-halo)",
        "text-halo-width": 1.4
