{
  "version": 8,
  "name": "Места VL.ru · Приморский край",
  "metadata": {
    "attribution": "© OpenStreetMap contributors, ODbL 1.0",
    "hermes:colors": "var(--map-*) — CSS-токены из web/static/css/app.css, подставляются клиентом (web/static/js/app/map-style.js)"
  },
  "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "region": {
      "type": "vector",
      "url": "pmtiles:///api/map/region.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "relief": {
      "type": "raster",
      "url": "pmtiles:///api/map/relief.pmtiles",
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors · рельеф Copernicus DEM"
    }
  },
  "layers": [
    {
      "id": "background-city",
      "type": "background",
      "paint": {
        "background-color": "var(--map-land)"
      },
      "metadata": {
        "hermes:mode": "city"
      }
    },
    {
      "id": "background-nature",
      "type": "background",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "background-color": "var(--map-nature-land)"
      },
      "metadata": {
        "hermes:mode": "nature"
      }
    },
    {
      "id": "relief-zones",
      "type": "raster",
      "source": "relief",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1,
        "raster-resampling": "nearest",
        "raster-fade-duration": 0,
        "raster-brightness-min": 0.16,
        "raster-saturation": -0.08,
        "raster-contrast": -0.05
      },
      "metadata": {
        "hermes:mode": "nature"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "region",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "var(--map-wood)",
        "fill-opacity": 0.9
      },
      "metadata": {
        "hermes:mode": "city"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "region",
      "source-layer": "landcover",
