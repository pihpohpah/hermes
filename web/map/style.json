    {
      "id": "waterway",
      "type": "line",
      "source": "region",
      "source-layer": "waterway",
      "minzoom": 9,
      "paint": {
        "line-color": "var(--map-waterway)",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.4,
          14,
          1.6
        ]
      },
      "metadata": {
        "hermes:mode": "both"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "region",
      "source-layer": "water",
      "paint": {
        "fill-color": "var(--map-water)"
      },
      "metadata": {
