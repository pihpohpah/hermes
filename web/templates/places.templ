package templates

import (
	"fmt"
	"strconv"

	"github.com/pihpohpah/hermes/internal/application/presenter"
	"github.com/pihpohpah/hermes/internal/domain/models"
)

func verdictLabel(verdict models.Verdict) string {
	switch verdict {
	case models.VerdictGo:
		return "Можно выходить"
	case models.VerdictNoGo:
		return "Не рекомендуется"
	default:
		return "Осторожно"
	}
}

func verdictClass(verdict models.Verdict) string {
	switch verdict {
	case models.VerdictGo:
		return "is-go"
	case models.VerdictNoGo:
		return "is-no-go"
	default:
		return "is-caution"
	}
}

func measureText(m models.Measure, layout string) string {
	if !m.Known {
		return "нет данных"
	}

	return fmt.Sprintf(layout, m.Value)
}

templ IndexShell() {
	<!doctype html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>ВЫХОДИ · Активный отдых во Владивостоке</title>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			<script src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js" defer></script>
			<style>
				:root {
					--bg: #f6f5f2;
					--surface: #ffffff;
					--border: #e2e0d8;
					--text: #181816;
					--muted: #65645e;
				}
				* { box-sizing: border-box; }
				[x-cloak] { display: none !important; }
				body {
					margin: 0;
					font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
					background: var(--bg);
					color: var(--text);
					line-height: 1.45;
				}
				.topbar {
					display: flex;
					align-items: center;
					justify-content: space-between;
					padding: 0.85rem 1.25rem;
					background: var(--surface);
					border-bottom: 1px solid var(--border);
				}
				.brand { font-weight: 700; }
				.tabs { display: flex; gap: 0.5rem; }
				.tab-btn {
					padding: 0.4rem 0.85rem;
					border: 1px solid var(--border);
					border-radius: 6px;
					background: var(--surface);
					cursor: pointer;
				}
				.tab-btn.is-active {
					background: var(--text);
					color: var(--surface);
					border-color: var(--text);
				}
				.layout {
					display: grid;
					grid-template-columns: 380px 1fr;
					min-height: calc(100vh - 58px);
				}
				.sidebar {
					padding: 1rem;
					border-right: 1px solid var(--border);
					background: var(--surface);
					overflow-y: auto;
				}
				.filters, .trip-form {
					display: grid;
					gap: 0.65rem;
					margin-bottom: 1rem;
					padding-bottom: 1rem;
					border-bottom: 1px solid var(--border);
				}
				.filters label, .trip-form label { font-size: 0.8rem; color: var(--muted); display: grid; gap: 0.25rem; }
				.filters select, .filters input, .filters button, .trip-form select, .trip-form input, .trip-form button {
					padding: 0.45rem 0.6rem;
					border: 1px solid var(--border);
					border-radius: 6px;
					font: inherit;
				}
				.places-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
				.place-card {
					padding: 0.85rem;
					border: 1px solid var(--border);
					border-radius: 8px;
					background: var(--bg);
				}
				.place-card__header { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted); }
				.place-card__title { margin: 0.35rem 0; font-size: 1rem; }
				.place-card__description { margin: 0 0 0.5rem; font-size: 0.85rem; color: var(--muted); }
				.place-card__meta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; font-size: 0.78rem; }
				.place-card__meta dt { color: var(--muted); }
				.place-card__meta dd { margin: 0; font-weight: 600; }
				.place-card__forecast { margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed var(--border); font-size: 0.78rem; }
				.place-card__score.is-go { color: #1f7a3f; }
				.place-card__score.is-caution { color: #a8700d; }
				.place-card__score.is-no-go { color: #b3261e; }
				.place-card__limitations { margin: 0.35rem 0 0; padding-left: 1rem; color: #a8700d; }
				.place-card__demo { margin: 0.35rem 0 0; color: #b3261e; font-weight: 600; }
				.place-card__disclaimer { margin: 0.35rem 0 0; color: var(--muted); }
				.place-card__actions { margin-top: 0.6rem; display: flex; gap: 0.5rem; }
				.workspace { padding: 1.25rem; }
				.map-island {
					min-height: 360px;
					border: 1px dashed var(--border);
					border-radius: 12px;
					background: #eceae4;
					padding: 1.25rem;
					margin-bottom: 1rem;
				}
				.panel-card {
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: 8px;
					padding: 1rem;
					margin-bottom: 1rem;
				}
			</style>
		</head>
		<body x-data="hermesShell()" x-init="init()">
			<header class="topbar">
				<div class="brand">ВЫХОДИ · Владивосток</div>
				<nav class="tabs" aria-label="Разделы">
					<button type="button" class="tab-btn" :class="tab === 'map' && 'is-active'" @click="tab = 'map'">Карта-заглушка</button>
					<button type="button" class="tab-btn" :class="tab === 'catalog' && 'is-active'" @click="tab = 'catalog'">Справочник и карточка</button>
					<button type="button" class="tab-btn" :class="tab === 'account' && 'is-active'" @click="tab = 'account'; loadTrips()">Аккаунт и планы</button>
				</nav>
				<div style="font-size: 0.8rem; color: var(--muted);">
					<span x-text="online ? 'В сети' : 'Офлайн · данные из кэша'"></span>
				</div>
			</header>
			<main class="layout">
				<aside class="sidebar">
					<form
						class="filters"
						hx-get="/fragments/places-list"
						hx-target="#places-list-container"
						hx-trigger="load, change, submit"
					>
						<label>
							Слой карты
							<select name="layer">
								<option value="">Все слои</option>
								<option value="city">Город</option>
								<option value="nature">Природа</option>
								<option value="sea">Море</option>
							</select>
						</label>
						<label>
							Тип места
							<select name="type">
								<option value="">Все типы</option>
								<option value="sup_spot">Сап-спот (sup_spot)</option>
								<option value="trailhead">Тропа (trailhead)</option>
								<option value="viewpoint">Смотровая (viewpoint)</option>
								<option value="park">Парк (park)</option>
								<option value="beach">Пляж (beach)</option>
							</select>
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<label>
								Широта (lat)
								<input type="number" step="0.0001" name="lat" value="43.1155"/>
							</label>
							<label>
								Долгота (lon)
								<input type="number" step="0.0001" name="lon" value="131.8855"/>
							</label>
						</div>
						<label>
							Радиус поиска PostGIS (м)
							<input type="number" step="500" name="radius_m" value="25000"/>
						</label>
						<button type="submit">Обновить список</button>
					</form>
					<div id="places-list-container">Загрузка справочника мест...</div>
				</aside>
				<section class="workspace">
					<div x-show="tab === 'map'" class="map-island" id="react-map-island" data-pmtiles-url="/api/pmtiles/region.pmtiles">
						<div class="panel-card">
							<h2 style="margin-top: 0;">Карта-заглушка (PMTiles + PostGIS)</h2>
							<p style="font-size: 0.9rem; color: var(--muted);">
								Офлайн-архив тайлов: <code>GET /api/pmtiles/region.pmtiles</code>.
							</p>
							<button type="button" @click="refreshForecast()">Пересчитать скоринг (POST /forecast/refresh)</button>
							<span x-show="forecastStatus" x-text="forecastStatus" style="margin-left: 0.5rem; font-size: 0.85rem;"></span>
						</div>
					</div>
					<div x-show="tab === 'catalog'" x-cloak>
						<div class="panel-card">
							<h2 style="margin-top: 0;">Карточка места и планирование поездки</h2>
							<div id="selected-place-card">
								<p style="font-size: 0.9rem; color: var(--muted);">Нажмите «Открыть карточку» у любого места слева.</p>
							</div>
							<template x-if="selectedPlaceId">
								<form class="trip-form" style="margin-top: 1rem;" @submit.prevent="createTrip()">
									<h3 style="margin: 0;">Запланировать поездку в <span x-text="selectedPlaceName"></span></h3>
									<label>
										Активность
										<select x-model="tripActivity">
											<option value="sup">SUP (sup)</option>
											<option value="hike">Поход (hike)</option>
											<option value="run">Пробежка (run)</option>
											<option value="walk">Прогулка (walk)</option>
										</select>
									</label>
									<label>
										Дата и время (ISO)
										<input type="datetime-local" x-model="tripPlannedLocal" required/>
									</label>
									<label>
										Заметки
										<input type="text" x-model="tripNotes" placeholder="Взять гермомешок и термос"/>
									</label>
									<button type="submit">Создать поездку (POST /trips)</button>
									<span x-show="tripMessage" x-text="tripMessage" style="font-size: 0.85rem;"></span>
								</form>
							</template>
						</div>
					</div>
					<div x-show="tab === 'account'" x-cloak>
						<div class="panel-card">
							<h2 style="margin-top: 0;">Личный аккаунт · Мои планы поездок</h2>
							<p style="font-size: 0.85rem; color: var(--muted);">
								Пользователь: <code x-text="userId"></code>
							</p>
							<button type="button" @click="loadTrips()">Обновить список поездок</button>
							<ul style="margin-top: 1rem;">
								<template x-for="trip in trips" :key="trip.id">
									<li>
										<strong x-text="trip.activity"></strong> · место <code x-text="trip.place_id"></code> —
										<span x-text="trip.planned_at"></span>
										(<span x-text="trip.status"></span>)
										<span x-text="trip.notes"></span>
									</li>
								</template>
							</ul>
							<p x-show="trips.length === 0" style="font-size: 0.85rem; color: var(--muted);">Пока нет запланированных выездов.</p>
						</div>
					</div>
				</section>
			</main>
			<script>
				document.addEventListener('alpine:init', () => {
					Alpine.data('hermesShell', () => ({
						tab: 'map',
						online: navigator.onLine,
						userId: '00000000-0000-0000-0000-000000000001',
						forecastStatus: '',
						selectedPlaceId: '',
						selectedPlaceName: '',
						tripActivity: 'sup',
						tripPlannedLocal: '2026-11-15T09:00',
						tripNotes: '',
						tripMessage: '',
						trips: [],

						init() {
							window.addEventListener('online', () => { this.online = true; });
							window.addEventListener('offline', () => { this.online = false; });
							window.addEventListener('open-place', (e) => {
								this.selectedPlaceId = e.detail.id;
								this.selectedPlaceName = e.detail.name;
								this.tripMessage = '';
								this.tab = 'catalog';
							});
						},

						async refreshForecast() {
							this.forecastStatus = 'Обновление...';
							const res = await fetch('/forecast/refresh', { method: 'POST' });
							const payload = await res.json();
							this.forecastStatus = payload.success
								? `Обновлено слотов: ${payload.data.updated_slots}`
								: `Ошибка: ${payload.error}`;
						},

						async createTrip() {
							const plannedAt = new Date(this.tripPlannedLocal).toISOString();
							const res = await fetch('/trips', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									user_id: this.userId,
									place_id: this.selectedPlaceId,
									planned_at: plannedAt,
									activity: this.tripActivity,
									notes: this.tripNotes,
								}),
							});
							const payload = await res.json();
							if (payload.success) {
								this.tripMessage = 'Поездка добавлена в планы!';
								await this.loadTrips();
								this.tab = 'account';
							} else {
								this.tripMessage = `Ошибка: ${payload.error}`;
							}
						},

						async loadTrips() {
							const res = await fetch(`/trips?user_id=${this.userId}`);
							const payload = await res.json();
							if (payload.success) {
								this.trips = payload.data || [];
							}
						},
					}));
				});
			</script>
		</body>
	</html>
}

templ PlacesList(items []presenter.Place) {
	if len(items) == 0 {
		<div class="places-empty">
			<p>В выбранном радиусе и слое места не найдены.</p>
		</div>
	} else {
		<ul class="places-list">
			for _, item := range items {
				<li class="places-list__item" data-place-id={ item.ID }>
					@PlaceCard(item)
				</li>
			}
		</ul>
	}
}

templ PlaceCard(item presenter.Place) {
	<article class="place-card" id={ "place-" + item.ID }>
		<header class="place-card__header">
			<span class="place-card__badge">{ string(item.Layer) } · { string(item.Type) }</span>
			if item.LatestScore != nil {
				<strong class={ "place-card__score", verdictClass(item.LatestScore.Verdict) }>
					{ verdictLabel(item.LatestScore.Verdict) } · комфорт { strconv.Itoa(int(item.LatestScore.Score)) }/100
				</strong>
			}
		</header>
		<h3 class="place-card__title">{ item.Name }</h3>
		<p class="place-card__description">{ item.Description }</p>
		<dl class="place-card__meta">
			<div>
				<dt>Координаты</dt>
				<dd>{ fmt.Sprintf("%.4f, %.4f", item.Lat, item.Lon) }</dd>
			</div>
			if item.DistanceM != nil {
				<div>
					<dt>Расстояние</dt>
					<dd>{ fmt.Sprintf("%.0f м", *item.DistanceM) }</dd>
				</div>
			}
			if item.Elevation != nil {
				<div>
					<dt>Высота</dt>
					<dd>{ fmt.Sprintf("%d м", *item.Elevation) }</dd>
				</div>
			}
			if item.Difficulty != nil {
				<div>
					<dt>Сложность</dt>
					<dd>{ fmt.Sprintf("%d/5", int(*item.Difficulty)) }</dd>
				</div>
			}
		</dl>
		if item.LatestScore != nil {
			<footer class="place-card__forecast">
				<span>
					{ string(item.LatestScore.Activity) } ·
					Ветер { measureText(item.LatestScore.Observation.WindSpeedMS, "%.1f м/с") } ·
					Порывы { measureText(item.LatestScore.Observation.WindGustMS, "%.1f м/с") } ·
					Волна { measureText(item.LatestScore.Observation.WaveHeightM, "%.2f м") } ·
					Вода { measureText(item.LatestScore.Observation.WaterTempC, "%.1f °C") } ·
					AQI { measureText(item.LatestScore.Observation.AirQualityIndex, "%.0f") }
				</span>
				<p>{ item.LatestScore.Summary }</p>
				if len(item.LatestScore.Limitations) > 0 {
					<ul class="place-card__limitations">
						for _, limitation := range item.LatestScore.Limitations {
							<li>{ limitation }</li>
						}
					</ul>
				}
				if item.LatestScore.Demo {
					<p class="place-card__demo">Демо-данные: не для реального выхода</p>
				}
				<p class="place-card__disclaimer">{ item.LatestScore.SafetyNotice }</p>
			</footer>
		}
		<div class="place-card__actions">
			<button
				type="button"
				hx-get={ "/fragments/place-card/" + item.ID }
				hx-target="#selected-place-card"
				hx-swap="innerHTML"
				data-place-id={ item.ID }
				data-place-name={ item.Name }
				onclick="window.dispatchEvent(new CustomEvent('open-place', { detail: { id: this.dataset.placeId, name: this.dataset.placeName } }))"
			>
				Открыть карточку
			</button>
		</div>
	</article>
}
