package templates

import (
	"strconv"

	"github.com/pihpohpah/hermes/internal/application/presenter"
)

// Экран «Карта»: сцена MapLibre + серверная панель. Панель обновляется htmx
// (фрагмент /fragments/map-panel), состояние — в URL. Логика макета explore.js
// переписана декларативно: каждая кнопка — ссылка с полным query.

templ MapPage(view MapView) {
	@Layout(LayoutView{
		Title:    "Пошли — VL.ru",
		Section:  "map",
		User:     view.User,
		LivePins: view.LivePins,
		Scenario: view.Query.Scenario,
		ScenarioHref: func(id string) string {
			return "/?s=" + id
		},
		WithMap: true,
	}) {
		@mapStage("items", view.Query.Scenario, view.LivePins) {
			@MapPanelInner(view)
		}
	}
}

// mapStage — статический каркас сцены (стили и поведение из stage.js макета).
templ mapStage(mode, scenario string, livePins int) {
	<div class="map-stage" id="map-stage" data-stage-mode={ mode } data-scenario={ scenario } aria-label="Карта">
		<div class="map-top" data-top></div>
		<button
			type="button"
			class="icon-btn icon-btn--floating panel-toggle"
			data-action="toggle-panel"
			aria-expanded="true"
			aria-controls="map-panel"
			aria-label="Скрыть панель"
			title="Скрыть панель"
			x-data="{ collapsed: false }"
			@click="collapsed = $root.closest('.map-stage').classList.toggle('is-panel-collapsed'); $dispatch('panel-toggle', collapsed)"
		>
			<template x-if="!collapsed">@icon("panel-left-close", "")</template>
			<template x-if="collapsed">@icon("panel-left-open", "")</template>
		</button>
		<div data-overlay>
			if mode == "items" && livePins > 0 {
				<a class="chip chip--lg chip--floating map-live-chip" href="/now">
					<span class="live-dot" aria-hidden="true"></span>
					Сейчас: { countLabel(livePins, [3]string{"метка", "метки", "меток"}) } от жителей
				</a>
			}
		</div>
		<aside class="map-panel" id="map-panel" data-sheet="peek" aria-label="Фильтры и список мест на карте">
			<button type="button" class="map-panel__handle" aria-controls="map-panel" aria-expanded="false"></button>
			<div id="map-panel-inner">
				{ children... }
			</div>
		</aside>
		<div class="map-controls">
			<div class="map-controls__group map-controls__zoom">
				<button type="button" class="icon-btn" data-action="zoom-in" aria-label="Приблизить" title="Приблизить">@icon("plus", "")</button>
				<button type="button" class="icon-btn" data-action="zoom-out" aria-label="Отдалить" title="Отдалить">@icon("minus", "")</button>
			</div>
			<div class="map-controls__group">
				<button type="button" class="icon-btn" data-action="locate" aria-label="Где я" title="Где я">@icon("locate-fixed", "")</button>
			</div>
		</div>
		<div
			class="route-bar"
			data-route-bar
			x-data="routeBar"
			x-show="visible"
			x-cloak
		>
			@routeBarCard()
		</div>
		<div class="map-picker" data-picker hidden>
			<div class="map-picker__pin">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" stroke="#fff" stroke-width="1.5" d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="10" r="2.6" fill="#fff"/></svg>
				<span class="map-picker__shadow"></span>
			</div>
		</div>
		<div class="map-canvas" id="map"></div>
		<div class="map-error" data-error hidden></div>
		<p class="visually-hidden" aria-live="polite" data-route-announcer></p>
	</div>
}

// routeBarCard — плашка маршрута; наполнение пересчитывает Alpine routeBar.
templ routeBarCard() {
	<div class="route-bar__card" role="region" aria-label="Маршрут" x-show="stops.length > 0">
		<span class="route-bar__icon">@icon("route", "")</span>
		<div class="route-bar__info">
			<strong x-text={ "stopsTitle()" }></strong>
			<span x-text="summary"></span>
		</div>
		<div class="segmented" role="group" aria-label="Способ передвижения" x-show="stops.length >= 2">
			<template x-for="m in modes" :key="m.id">
				<button type="button" class="segmented__item" :aria-pressed="mode === m.id" @click="setMode(m.id)" x-text="m.label"></button>
			</template>
		</div>
		<div class="route-bar__actions">
			<a class="btn btn--sm btn--outline" :href="editorURL">@icon("pencil", "icon--sm") Изменить</a>
			<button type="button" class="icon-btn icon-btn--sm" data-action="route-clear" aria-label="Очистить маршрут" title="Очистить маршрут">@icon("x", "")</button>
		</div>
	</div>
}

// MapPanelInner — внутренности панели карты; целиком заменяется htmx-фрагментом.
templ MapPanelInner(view MapView) {
	{{
		q := view.Query
		chips := mapActiveChips(q)
		resultForms := mapResultForms(q.Type)
	}}
	<div class="map-panel__head" data-head>
		<div class="segmented map-panel__view" role="tablist" aria-label="Содержимое панели" data-view-tabs>
			<a
				id="map-tab-filters"
				role="tab"
				class="segmented__item"
				href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Tab = "filters" }).pageURL()) }
				hx-get={ q.with(func(n *MapQueryView) { n.Tab = "filters" }).fragmentURL() }
				hx-target="#map-panel-inner"
				hx-push-url={ q.with(func(n *MapQueryView) { n.Tab = "filters" }).pageURL() }
				aria-selected={ strconv.FormatBool(q.Tab != "list") }
				aria-controls="map-panel-content"
			>Фильтры</a>
			<a
				id="map-tab-list"
				role="tab"
				class="segmented__item"
				href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Tab = "list" }).pageURL()) }
				hx-get={ q.with(func(n *MapQueryView) { n.Tab = "list" }).fragmentURL() }
				hx-target="#map-panel-inner"
				hx-push-url={ q.with(func(n *MapQueryView) { n.Tab = "list" }).pageURL() }
				aria-selected={ strconv.FormatBool(q.Tab == "list") }
				aria-controls="map-panel-content"
			>
				Список <span class="segmented__count" data-list-count>{ strconv.Itoa(len(view.Items)) }</span>
			</a>
		</div>
		<div data-slot-home="search">
			@mapSearchForm(q)
		</div>
		<div data-slot-home="chips">
			<div class="chip-row chip-row--wrap" role="group" aria-label="Категории" data-top-slot="chips">
				@mapCategoryChips(view)
			</div>
		</div>
		<div class="map-panel__toolbar" data-toolbar>
			<span class="map-panel__count" aria-live="polite" data-count>
				<strong>{ countLabel(len(view.Items), resultForms) }</strong>
			</span>
			@mapTypeSegment(view)
		</div>
		if q.Tab == "list" && len(chips) > 0 {
			<div class="chip-row" data-active-filters>
				for _, chip := range chips {
					@filterChip(chip.Label, chip.Page, chip.Fragment)
				}
			</div>
		}
	</div>
	<div class="map-panel__body" id="map-panel-content" data-body role="tabpanel" aria-labelledby={ mapTabLabel(q.Tab) }>
		if view.Selected != nil {
			@mapPreview(*view.Selected, q)
		} else if q.Panel == "route" {
			@routeEditorPanel(q)
		} else if q.Tab == "list" {
			@mapList(view, q)
		} else {
			@mapFiltersForm(view, q)
		}
	</div>
	if view.Selected == nil && q.Panel != "route" {
		<div class="map-panel__foot" data-foot>
			<span>Не нашли место?</span><a href={ "/add?scenario=" + q.Scenario }>@icon("plus", "icon--sm") Предложить</a>
		</div>
	}
}

func mapTabLabel(tab string) string {
	if tab == "list" {
		return "map-tab-list"
	}

	return "map-tab-filters"
}

func mapResultForms(itemType string) [3]string {
	switch itemType {
	case "place":
		return [3]string{"место", "места", "мест"}
	case "event":
		return [3]string{"событие", "события", "событий"}
	default:
		return [3]string{"результат", "результата", "результатов"}
	}
}

// mapSearchForm — поиск; URL обновляет делегированный обработчик (debounce 250 мс).
templ mapSearchForm(q MapQueryView) {
	<form class="map-panel__search" role="search" data-top-slot="search" data-role="map-search">
		<div class="input-group">
			@icon("search", "")
			<input class="input" type="search" name="q" value={ q.Q } placeholder="Название, район или тег" aria-label="Поиск по местам" autocomplete="off" enterkeyhint="search"/>
			if q.Q != "" {
				<a
					class="icon-btn icon-btn--sm input-group__action"
					data-action="clear-search"
					aria-label="Очистить поиск"
					href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Q = "" }).pageURL()) }
				>@icon("x", "")</a>
			}
		</div>
		<a
			class="icon-btn icon-btn--muted filter-btn"
			data-action="filters"
			aria-label={ mapFiltersAriaLabel(viewActiveFiltersCount(q)) }
			aria-pressed={ strconv.FormatBool(q.Tab != "list") }
			href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Tab = "filters" }).pageURL()) }
			hx-get={ q.with(func(n *MapQueryView) { n.Tab = "filters" }).fragmentURL() }
			hx-target="#map-panel-inner"
			hx-push-url={ q.with(func(n *MapQueryView) { n.Tab = "filters" }).pageURL() }
		>
			@icon("sliders-horizontal", "")
			if viewActiveFiltersCount(q) > 0 {
				<span class="filter-btn__count">{ strconv.Itoa(viewActiveFiltersCount(q)) }</span>
			}
		</a>
	</form>
}

func viewActiveFiltersCount(q MapQueryView) int {
	return hasFilterCount(q.Filters)
}

func hasFilterCount(f presenter.CatalogFilter) int {
	count := 0
	if f.Free {
		count++
	}
	if f.Walkable {
		count++
	}
	if f.Kids {
		count++
	}
	if f.Distance > 0 {
		count++
	}
	if f.NoCar {
		count++
	}
	if f.Swim {
		count++
	}
	count += len(f.Difficulty)
	count += len(f.Beach)

	return count
}

func mapFiltersAriaLabel(active int) string {
	if active > 0 {
		return "Фильтры, выбрано: " + strconv.Itoa(active)
	}

	return "Фильтры"
}

// mapCategoryChips — категории активного сценария со счётчиками.
templ mapCategoryChips(view MapView) {
	{{
		q := view.Query
		categories := presenter.Categories[q.Scenario]
	}}
	<a
		class="chip"
		href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Category = "" }).pageURL()) }
		hx-get={ q.with(func(n *MapQueryView) { n.Category = "" }).fragmentURL() }
		hx-target="#map-panel-inner"
		hx-push-url={ q.with(func(n *MapQueryView) { n.Category = "" }).pageURL() }
		aria-pressed={ strconv.FormatBool(q.Category == "") }
	>Все</a>
	for _, category := range categories {
		<a
			class="chip"
			href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Category = category.ID }).pageURL()) }
			hx-get={ q.with(func(n *MapQueryView) { n.Category = category.ID }).fragmentURL() }
			hx-target="#map-panel-inner"
			hx-push-url={ q.with(func(n *MapQueryView) { n.Category = category.ID }).pageURL() }
			aria-pressed={ strconv.FormatBool(q.Category == category.ID) }
		>
			@icon(category.Icon, "")
{ category.Label }
			if view.CategoryCounts[category.ID] > 0 {
				<span class="chip__count">{ strconv.Itoa(view.CategoryCounts[category.ID]) }</span>
			}
		</a>
	}
}

// mapTypeSegment — сегмент «Всё/Места/События».
templ mapTypeSegment(view MapView) {
	{{
		q := view.Query
		types := []struct {
			id    string
			label string
		}{
			{"all", "Всё"},
			{"place", "Места"},
			{"event", "События"},
		}
	}}
	<div class="segmented" role="group" aria-label="Тип">
		for _, t := range types {
			<a
				class="segmented__item"
				href={ templ.SafeURL(q.with(func(n *MapQueryView) { n.Type = t.id }).pageURL()) }
				hx-get={ q.with(func(n *MapQueryView) { n.Type = t.id }).fragmentURL() }
				hx-target="#map-panel-inner"
				hx-push-url={ q.with(func(n *MapQueryView) { n.Type = t.id }).pageURL() }
				aria-pressed={ strconv.FormatBool(q.Type == t.id) }
			>
				{ t.label }
				if t.id != "all" && view.TypeCounts[t.id] > 0 {
					<span class="segmented__count">{ strconv.Itoa(view.TypeCounts[t.id]) }</span>
				}
			</a>
		}
	</div>
}

// mapFiltersForm — встроенная форма фильтров сценария (вкладка «Фильтры»).
templ mapFiltersForm(view MapView, q MapQueryView) {
	<form class="filters-form map-panel__filters" data-role="map-filters" data-scenario={ q.Scenario }>
		<p class="map-panel__filters-note">Места на карте обновляются сразу после выбора.</p>
		for _, spec := range presenter.Filters[q.Scenario] {
			@filterField(spec, q.Filters)
		}
		<a class="btn btn--outline" href={ "/?s=" + q.Scenario }>Сбросить всё</a>
	</form>
}

// filterField — одно поле фильтра по спецификации сценария.
templ filterField(spec presenter.FilterSpec, f presenter.CatalogFilter) {
	if spec.Type == "toggle" {
		<label class="switch filter-field">
			<span>
				<span class="filter-field__label">{ spec.Label }</span>
				if spec.Hint != "" {
					<span class="filter-field__hint">{ spec.Hint }</span>
				}
			</span>
			<input type="checkbox" name={ spec.ID } checked?={ filterToggleOn(spec.ID, f) }/>
		</label>
	} else {
		<fieldset class="fieldset filter-field">
			<legend class="filter-field__label">{ spec.Label }</legend>
			<div class="chip-row chip-row--wrap">
				for _, option := range spec.Options {
					<label class="chip chip--lg">
						if spec.Type == "multi" {
							<input type="checkbox" name={ spec.ID } value={ option.Value } checked?={ filterMultiOn(spec.ID, option.Value, f) }/>
						} else {
							<input type="radio" name={ spec.ID } value={ option.Value } checked?={ filterSingleOn(spec.ID, option.Value, f) }/>
						}
						{ option.Label }
					</label>
				}
			</div>
		</fieldset>
	}
}

func filterToggleOn(id string, f presenter.CatalogFilter) bool {
	switch id {
	case "free":
		return f.Free
	case "walkable":
		return f.Walkable
	case "kids":
		return f.Kids
	case "noCar":
		return f.NoCar
	case "swim":
		return f.Swim
	}

	return false
}

func filterMultiOn(id, value string, f presenter.CatalogFilter) bool {
	list := f.Difficulty
	if id == "beach" {
		list = f.Beach
	}
	for _, item := range list {
		if item == value {
			return true
		}
	}

	return false
}

func filterSingleOn(id, value string, f presenter.CatalogFilter) bool {
	if id != "distance" {
		return false
	}
	if value == "" {
		return f.Distance == 0
	}

	return strconv.FormatFloat(f.Distance, 'f', -1, 64) == value
}

// mapList — вкладка «Список»: сгруппированные результаты или пустое состояние.
templ mapList(view MapView, q MapQueryView) {
	if len(view.Items) == 0 {
		@mapEmpty(q)
	} else {
		{{
			events := filterItemsByType(view.Items, "event")
			places := filterItemsByType(view.Items, "place")
			grouped := q.Type == "all" && len(events) > 0 && len(places) > 0
		}}
		if grouped {
			<h3 class="map-panel__group-title">Скоро</h3>
			<ul class="map-panel__list" role="list">
				for _, item := range events {
					@resultRow(item, false)
				}
			</ul>
			<h3 class="map-panel__group-title">Места</h3>
			<ul class="map-panel__list" role="list">
				for _, item := range places {
					@resultRow(item, false)
				}
			</ul>
		} else {
			<ul class="map-panel__list" role="list">
				for _, item := range view.Items {
					@resultRow(item, false)
				}
			</ul>
		}
	}
}

func filterItemsByType(items []presenter.CatalogItem, itemType string) []presenter.CatalogItem {
	out := make([]presenter.CatalogItem, 0, len(items))
	for _, item := range items {
		if item.Type == itemType {
			out = append(out, item)
		}
	}

	return out
}

templ mapEmpty(q MapQueryView) {
	<div class="empty">
		<span class="empty__icon">@icon("search", "icon--lg")</span>
		<h2 class="empty__title">Ничего не нашлось</h2>
		<p class="empty__text">
			if q.Q != "" {
				По запросу «{ q.Q }» в разделе «{ presenter.ScenarioInfo(q.Scenario).Label }» пусто.
			} else {
				С такими условиями мест нет.
			}
			Попробуйте изменить условия или загляните в другой раздел.
		</p>
		<div class="empty__actions">
			if hasFilterCount(q.Filters) > 0 || q.Q != "" || q.Category != "" || q.Type != "all" {
				<a class="btn btn--primary" href={ "/?s=" + q.Scenario }>Сбросить всё</a>
			}
			<a class="btn btn--outline" href={ "/add?scenario=" + q.Scenario }>Предложить место</a>
		</div>
	</div>
}

// mapPreview — карточка выбранного объекта во вкладке панели.
templ mapPreview(item presenter.CatalogItem, q MapQueryView) {
	{{
		category := presenter.CategoryInfo(item.Scenario, item.Category, item.Type)
		backQ := q
		backQ.Selected = ""
		backLabel := "К фильтрам"
		if q.Tab == "list" {
			backLabel = "К списку"
		}
	}}
	<article class="preview" aria-labelledby="preview-title">
		<div class="preview__bar">
			<a class="btn btn--sm btn--ghost" href={ templ.SafeURL(backQ.pageURL()) } hx-get={ backQ.fragmentURL() } hx-target="#map-panel-inner" hx-push-url={ backQ.pageURL() }>
				@icon("arrow-left", "icon--sm")
{ backLabel }
			</a>
			<button
				type="button"
				class="icon-btn icon-btn--sm"
				data-action="share"
				data-share-title={ item.Title }
				data-share-text={ item.Short }
				data-share-url={ itemURL(item) }
				aria-label="Поделиться"
				title="Поделиться"
			>@icon("share-2", "")</button>
		</div>
		<div class="preview__gallery-wrap">
			<div class="preview__gallery" tabindex="0" role="region" aria-label="Фотографии">
				@previewGallery(item)
			</div>
			if len(item.Photos) > 1 {
				<div class="preview__dots" aria-hidden="true">
					for i := 0; i < len(item.Photos); i++ {
						<span class={ dotClass(i) }></span>
					}
				</div>
			}
		</div>
		<header>
			<div class="preview__meta">
				<span class={ "badge badge--" + previewBadgeClass(item) }>@icon(category.Icon, "")
{ category.Label }</span>
				<span>
					if item.Type == "event" {
						{ item.District }
					} else {
						{ item.District } · { formatDistance(item.DistanceKm) } от центра
					}
				</span>
			</div>
			<h2 class="preview__title" id="preview-title" style="margin-top: var(--space-2)">{ item.Title }</h2>
		</header>
		<div class="preview__actions">
			<a class="btn btn--primary" href={ itemURL(item) }>Подробнее</a>
			@routeToggleButton(item, "btn btn--outline")
		</div>
		<p class="preview__text">{ item.Short }</p>
		@previewFacts(item)
		if item.HowToGet != "" {
			<div>
				<h3 class="preview-subtitle">Как добраться</h3>
				<p class="preview__text">{ item.HowToGet }</p>
				<div class="chip-row chip-row--wrap" style="margin-top: var(--space-3)">
					for _, mode := range item.Access {
						if info, ok := presenter.AccessModes[mode]; ok {
							<span class="badge">@icon(info.Icon, "")
{ info.Label }</span>
						}
					}
				</div>
			</div>
		}
		if len(item.Photos) > 0 && item.Photos[0].Author != "" {
			<p class="preview__credit">Фото: { item.Photos[0].Author }, { item.Photos[0].License }</p>
		}
	</article>
}

func previewBadgeClass(item presenter.CatalogItem) string {
	if item.Type == "event" {
		return "timed"
	}

	return item.Scenario
}

templ previewGallery(item presenter.CatalogItem) {
	if len(item.Photos) == 0 {
		@media(item, "lg", 0, "", nil, true)
	} else {
		for i := 0; i < len(item.Photos); i++ {
			@media(item, "lg", i, "", nil, i == 0)
		}
	}
}

templ previewFacts(item presenter.CatalogItem) {
	<dl class="facts preview__facts">
		if item.Type == "event" {
			<div class="fact">@icon("calendar", "")<div><dt>Когда</dt><dd>{ formatEventWhen(item.StartsAt) }</dd></div></div>
			<div class="fact">@icon("map-pin", "")<div><dt>Где</dt><dd>{ item.Venue }</dd></div></div>
			<div class="fact">@icon("ticket", "")<div><dt>Вход</dt><dd>{ priceLabel(item) }{ previewAge(item) }</dd></div></div>
		} else {
			<div class="fact">@icon("map-pin", "")<div><dt>Адрес</dt><dd>{ item.Address }</dd></div></div>
			<div class="fact">@icon("clock", "")<div><dt>Время</dt><dd>{ item.Hours }</dd></div></div>
			<div class="fact">@icon("wallet", "")<div><dt>Стоимость</dt><dd>{ priceLabel(item) }</dd></div></div>
			if item.Difficulty != nil {
				<div class="fact">@icon("mountain", "")<div><dt>Сложность</dt><dd>{ presenter.DifficultyLabels[difficultyCodeOf(item)] }</dd></div></div>
			}
			if item.Beach != "" && item.Beach != "none" {
				<div class="fact">@icon("sun", "")<div><dt>Берег</dt><dd>{ presenter.BeachLabels[item.Beach] }</dd></div></div>
			}
		}
	</dl>
}

func previewAge(item presenter.CatalogItem) string {
	if item.Age != "" {
		return " · " + item.Age
	}

	return ""
}

// routeEditorPanel — редактор маршрута (panel=route); данные — клиентский routeStore.
templ routeEditorPanel(q MapQueryView) {
	{{
		closeQ := q
		closeQ.Panel = ""
	}}
	<div class="preview" x-data="routeEditor" x-init="init($el)" data-role="route-editor">
		<div class="preview__bar">
			<a class="btn btn--sm btn--ghost" href={ templ.SafeURL(closeQ.pageURL()) } hx-get={ closeQ.fragmentURL() } hx-target="#map-panel-inner" hx-push-url={ closeQ.pageURL() }>
				@icon("arrow-left", "icon--sm") Назад
			</a>
			<button type="button" class="btn btn--sm btn--danger" data-action="route-clear" x-show="stops.length > 0">
				@icon("trash-2", "icon--sm") Очистить
			</button>
		</div>
		<div>
			<h2 class="preview__title">Маршрут</h2>
			<p class="preview__meta">Порядок точек можно менять стрелками</p>
		</div>
		<div class="segmented" role="group" aria-label="Способ передвижения" x-show="stops.length >= 2">
			<template x-for="m in modes" :key="m.id">
				<button type="button" class="segmented__item" :aria-pressed="mode === m.id" @click="setMode(m.id)" x-text="m.label"></button>
			</template>
		</div>
		<template x-if="stops.length === 0">
			<div class="empty">
				<span class="empty__icon">@icon("route", "icon--lg")</span>
				<h2 class="empty__title">Маршрут пока пуст</h2>
				<p class="empty__text">Нажмите «В маршрут» у места в списке или на его странице — точка появится здесь. Можно собрать до 6 точек.</p>
			</div>
		</template>
		<template x-if="stops.length >= 2">
			<dl class="route-summary">
				<div class="route-summary__item"><dt>Расстояние</dt><dd x-text="distance"></dd></div>
				<div class="route-summary__item"><dt>В пути</dt><dd x-text="duration"></dd></div>
			</dl>
		</template>
		<div class="alert alert--warning" x-show="approximate">
			@icon("triangle-alert", "")<span>Сервис маршрутов не ответил, поэтому расстояние посчитано по прямой с поправкой. Точный путь — в навигаторе.</span>
		</div>
		<ol class="route-list" role="list">
			<template x-for="(stop, index) in stops" :key="stop.id">
				<li class="route-stop">
					<span class="route-stop__num" aria-hidden="true" x-text="index + 1"></span>
					<div>
						<a class="route-stop__title" :href="stop.url" x-text="stop.title"></a>
						<div class="route-stop__leg" x-show="stop.leg" x-text="stop.leg"></div>
					</div>
					<div class="route-stop__actions">
						<button type="button" class="icon-btn icon-btn--sm" @click="move(index, -1)" :disabled="index === 0" aria-label="Выше">@icon("chevron-up", "")</button>
						<button type="button" class="icon-btn icon-btn--sm" @click="move(index, 1)" :disabled="index === stops.length - 1" aria-label="Ниже">@icon("chevron-down", "")</button>
						<button type="button" class="icon-btn icon-btn--sm" @click="remove(stop.id)" aria-label="Убрать из маршрута">@icon("x", "")</button>
					</div>
				</li>
			</template>
		</ol>
		<a class="btn btn--outline btn--block" :href="yandexUrl" target="_blank" rel="noopener" x-show="stops.length >= 2">
			@icon("external-link", "") Открыть в Яндекс Картах
		</a>
		<div class="alert alert--neutral" x-show="stops.length === 1">
			@icon("info", "")<span>Добавьте ещё хотя бы одну точку, чтобы построить путь.</span>
		</div>
	</div>
}
